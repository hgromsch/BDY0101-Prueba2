# Copiar como .env y completar. NUNCA subir el .env real al repositorio.
# Usuario administrador del proyecto (scripts de importación, índices y validadores)
MONGODB_URI=mongodb+srv://<usuario_admin>:<clave>@<cluster>.mongodb.net/
# Usuario de la aplicación con rol readWrite@contentflow (lo usa la API REST)
MONGODB_URI_APP=mongodb+srv://contentflow_app:<clave>@<cluster>.mongodb.net/
MONGODB_DB=contentflow
# Opcionales
MONGODB_TIMEOUT_MS=5000
# LOG_FILE=api/logs/api.log
