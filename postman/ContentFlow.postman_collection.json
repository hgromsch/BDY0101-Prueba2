  "item": [
    {
      "name": "1. Conectividad",
      "item": [
        {
          "name": "Salud: ping a MongoDB Atlas",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/salud",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "salud"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('Atlas conectado', () => pm.expect(pm.response.json().atlas).to.eql('conectado'));",
                  "pm.test('Región SA_EAST_1', () => pm.expect(pm.response.json().region).to.eql('SA_EAST_1'));"
                ]
              }
            }
          ]
        }
      ]
    },
